    <!--Generic Lamp/Bulb -->
     <nodeDef id="STDLAMP" nls="STDL">
        <editors />
        <sts>
            <st id="ST" editor="ONOFF" />
            <st id="OL" editor="OL"/>
        </sts>
        <cmds>
            <sends>
                <cmd id="DON" />
                <cmd id="DOF" />
                <cmd id="OL" />
            </sends>
            <accepts>
                <cmd id="DON" />
                <cmd id="DOF" />
                <cmd id="QUERY" />
                <cmd id="SETLVL">
                    <p id="" editor="OUTL"  init="OL"/>
                </cmd>
            </accepts>
        </cmds>
    </nodeDef>
    
    <!-- Color Lamp/Bulb/Light -->
    
    <nodeDef id="COLORLIGHT" nls="ZCL">
        <editors />
        <sts>
            <st id="ST" editor="STATUS" />
            <st id="OL" editor="OL"/> <!-- Brightness -->
            <st id="GV3" editor="ZCLHUE" /> <!-- Hue -->
            <st id="GV4" editor="ZCLSAT" /> <!-- Saturation -->
            <st id="GV5" editor="COLORMODE"/> <!-- Color Mode -->
            <st id="GV6" editor="KELVIN" /> <!-- Color Temperature -->
        </sts>
        <cmds>
            <sends>
                <cmd id="DON" />
                <cmd id="DOF" />
                <cmd id="QUERY" />
                <cmd id="SETLVL">
                    <p id="" editor="OL"/>
                </cmd>
                <cmd id="SET_HUE">
                    <p id="" editor="ZCLHUE" init="GV3"/>
                </cmd>
                <cmd id="SET_SAT">
                    <p id="" editor="ZCLSAT" init="GV4"/>
                </cmd>
                <cmd id="SET_KELVIN">
                    <p id="" editor="KELVIN" init="GV6"/>
                </cmd>
            </sends>
            <accepts>
	            <cmd id="DON" />
                <cmd id="DOF" />
                <cmd id="DFON" />
                <cmd id="DFOF" />
                <cmd id="QUERY" />
